{
  "name": "geet",
  "version": "1.3.0",
  "description": "Personal git productivity CLI",
  "bin": {
    "geet": "./dist/index.js"
  },
  "type": "module",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "node src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "husky && npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "@inquirer/search": "^4.2.1",
    "clipboardy": "^5.0.0",
    "commander": "^12.0.0",
    "dotenv": "^17.4.2",
    "execa": "^9.0.0",
    "omelette": "^0.4.17"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "lint-staged": {
    "*.ts": [
      "oxlint",
      "oxfmt"
    ]
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
